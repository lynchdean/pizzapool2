DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=

# Optional — default sensibly based on DEBUG, only set these to override:
# SECURE_SSL_REDIRECT=
# SESSION_COOKIE_SECURE=
# CSRF_COOKIE_SECURE=

# Optional — defaults to printing emails to the console. Set these to send
# password-reset emails via a real SMTP provider:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=
